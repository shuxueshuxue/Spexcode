  "cards": [
    {
      "dot": "cyan",
      "title": "写路径与读路径汇于真源",
      "items": [
        "写：终端的 session 动词驱动 sessions，会话在自己的 worktree 里改 .spec，那是对 main 的带署名提案",
        "读：source-of-truth 从 .spec 和 git 派生每个节点的版本、drift 和状态，read-surfaces 是读它的各张脸——整张图、终端树、静态发布、搜索、打开节点与源码"
      ]
    },
    {
      "dot": "amber",
      "title": "serve 承载这一切",
      "items": [
        "supervisor 持有端口，热重载不留空窗；绑不上端口就响亮地非零退出",
        "public-mode 与 host-gateway 是面向网络的 gateway，后端始终在 loopback",
        "它启动的每个会话都继承同一个稳定的 SPEXCODE_API_URL"
      ]
    },
    {
      "dot": "violet",
      "title": "Issue 与引用",
      "items": [
        "本地与 forge 的 Issue 是同一个对象；正文里的节点引用、@session、@new 由 mentions 的一套语法解析",
        "证据字节按哈希放在 evidence-store，Issue 只引用哈希"
      ]
    },
    {
      "dot": "slate",
      "title": "折叠与省略",
      "items": [
        "others 折进 flat（Flatcode）、test-home-isolation、worktree-resilience：三个互不相干、也不属于任何分组的独立契约",
        "cli-surface 是所有动词的入口，图上只画驱动会话这一条主干"
      ]
    }
  ]
}
