#!/usr/bin/env bash
# @@@ candidate lint arm ([[code-anchor]]) - commit-msg proves this commit path reached the local gate and
# owns the final message + exact commit index. It does not guess parents or run lint: it atomically arms the
# per-worktree git-dir for reference-transaction, which will judge Git's real commit oid before refs advance.
set -euo pipefail
msg_file="$1"
marker=$(git rev-parse --git-path SPEXCODE_PENDING_LINT)
rm -f "$marker"
[ -z "${SPEXCODE_SKIP_LINT:-}" ] || exit 0

# Never arm into a missing/custom consumer. Identity is a static CRC + byte count over SpexCode's exact
# installed template: a user hook is never executed with a made-up probe argument.
consumer=$(git rev-parse --git-path hooks/reference-transaction)
consumer_identity=$(cksum < "$consumer" 2>/dev/null || true)
if [ ! -x "$consumer" ] || [ "$consumer_identity" != "31276137 3864" ]; then
  exit 0
fi

head=$(git rev-parse HEAD 2>/dev/null || printf '%s' unborn)
tree=$(git write-tree)
message=$(git hash-object --stdin < "$msg_file")
armed_at=$(date +%s)
tmp="${marker}.lock.$$"
printf '%s\n%s\n%s\n%s\n' "$head" "$tree" "$message" "$armed_at" > "$tmp"
mv "$tmp" "$marker"
[ -z "${SPEXCODE_GATE_TRACE:-}" ] || echo "spexcode-gate: armed head=$head tree=$tree message=$message marker=$marker" >&2
exit 0
