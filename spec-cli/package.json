{
  "name": "@spexcode/spec-cli",
  "version": "0.7.0-next.12",
  "type": "module",
  "description": "SpexCode CLI + server. The root spexcode package delegates to this compiled package; dashboard assets live in @spexcode/spec-dashboard.",
  "bin": {
    "spex": "bin/spex.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./bin/spex.mjs": "./bin/spex.mjs",
    "./ranker": "./dist/ranker.js",
    "./eval-host": "./dist/eval-host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "hooks"
  ],
  "bundledDependencies": [
    "@spexcode/spec-core",
    "@spexcode/spec-eval",
    "@spexcode/spec-forge"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../scripts/build-dist.mjs",
    "prepublishOnly": "node ../scripts/release-publish.mjs --from-package-publish",
    "serve": "npm run build && node bin/spex.mjs serve",
    "lint": "npm run build && node bin/spex.mjs spec lint",
    "test": "tsx --import ../scripts/test-home.mjs --test src/*.test.ts"
  },
  "dependencies": {
    "@spexcode/session-application": "0.7.0-next.12",
    "@spexcode/session-selflaunch": "0.7.0-next.12",
    "@spexcode/spec-core": "0.7.0-next.12",
    "@spexcode/spec-eval": "0.7.0-next.12",
    "@spexcode/spec-forge": "0.7.0-next.12",
    "@spexcode/transcript": "0.7.0-next.12",
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
