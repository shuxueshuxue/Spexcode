{
  "lint": {
    "governedRoots": [
      "."
    ]
  },
  "uploads": {
    "maxBytes": 2147483648,
    "chunkBytes": 8388608,
    "concurrency": 1,
    "requestTimeoutMs": 120000,
    "retryLimit": 2,
    "retryDelayMs": 500,
    "incompleteTtlMs": 86400000,
    "cleanupIntervalMs": 3600000,
    "minFreeBytes": 268435456,
    "evidenceMaxBytes": 52428800
  },
  "sessions": {
    "launchers": {
      "claude-headless": {
        "harness": "claude-headless",
        "cmd": "claude"
      },
      "claude": {
        "harness": "claude",
        "cmd": "claude"
      },
      "codex-headless": {
        "harness": "codex-headless",
        "cmd": "codex --yolo"
      },
      "codex": {
        "harness": "codex",
        "cmd": "codex"
      },
      "opencode-headless": {
        "harness": "opencode-headless",
        "cmd": "opencode --auto"
      },
      "opencode": {
        "harness": "opencode",
        "cmd": "opencode"
      },
      "pi-headless": {
        "harness": "pi-headless",
        "cmd": "pi"
      },
      "pi": {
        "harness": "pi",
        "cmd": "pi"
      }
    },
    "defaultLauncher": "claude-headless"
  }
}
