{
  "id": "spexcode",
  "name": "SpexCode",
  "defaultLocale": "en",
  "subtitle": "Spec tree, drift and diagrams",
  "localized": {
    "zh-CN": {
      "name": "SpexCode",
      "subtitle": "规格树、代码漂移与架构图",
      "examples": [
        "给这个仓库画一份规格图",
        "哪些规格和代码漂移了?"
      ]
    }
  },
  "examples": [
    "Draw the spec atlas of this repository",
    "Which specs have drifted from the code?"
  ],
  "author": "SpexCode",
  "homepage": "https://spexcode.net",
  "repository": "https://github.com/shuxueshuxue/spexcode",
  "license": "MIT",
  "categories": [
    "developer"
  ],
  "version": "0.8.0",
  "apiVersion": 24,
  "platforms": [
    "desktop",
    "phone"
  ],
  "engines": {
    "gugu": ">=0.3.1"
  },
  "entry": "index.html",
  "icon": "icon.png",
  "permissions": {
    "capabilities": [
      "files:read",
      "files:write",
      "agents:read",
      "agents:control",
      "agents:tools"
    ]
  },
  "contributes": {
    "tabs": [
      {
        "name": "spec",
        "title": "SpexCode",
        "entry": "index.html",
        "icon": "icon.png",
        "toolbar": [
          {
            "id": "draw",
            "title": "Draw the atlas"
          },
          {
            "id": "refresh",
            "title": "Refresh"
          }
        ]
      },
      {
        "name": "snapshot",
        "title": "SpexCode",
        "entry": "index.html",
        "icon": "icon.png",
        "opensFiles": {
          "chat": [
            ".spexcode"
          ]
        }
      }
    ],
    "mcpServers": [
      {
        "tools": "tools.js"
      }
    ],
    "skills": "skills",
    "instructions": "Read skill spexcode in a repository with a .spec/ tree; skill atlas draws its diagrams. spexcode__share puts the tree into a group."
  }
}
