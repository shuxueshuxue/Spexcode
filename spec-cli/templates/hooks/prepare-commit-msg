#!/usr/bin/env bash
# @@@ session-stamp - auto-attribute a commit to the SESSION that authored it, ACROSS HARNESSES. SpexCode
# reads the `Session:` trailer as a version's attribution (git is the database), keyed by the SpexCode record
# id so the dashboard's session window links to it. The authoring session is read from the TREE, not from the
# environment: a session OWNS its worktree, so the record whose `worktree_path` IS the tree being committed in
# is the author — a fact this hook can verify at commit time, in the same project store the board reads.
# That makes attribution harness-agnostic (no CLAUDE_CODE_SESSION_ID / CODEX_THREAD_ID / SPEXCODE_SESSION_ID
# tiers to keep in sync with the adapters) and, more importantly, HONEST. An env-read cannot be verified: a
# shared harness daemon — codex's per-project app-server — outlives the session that started it and leaks that
# session's baked SPEXCODE_SESSION_ID into every later thread's tool shell, so an env-trusting hook stamped a
# STRANGER's id on other sessions' commits (github#76: 48 commits in this repo, and the id was untraceable
# once that session closed and its record was swept).
# So: no owning record → NO trailer. A commit from the main checkout, a hand-made integration worktree, or any
# repo this store knows nothing about is left unstamped rather than attributed to a guess (merge commits are
# not versions — `git log --numstat` skips them — so nothing downstream loses a row). An existing Session:
# trailer is likewise left alone, so the dogfood ritual / a human can still set one explicitly.
set -euo pipefail
msg_file="$1"
grep -qiE '^Session:[[:space:]]' "$msg_file" && exit 0

# the tree being committed in, and the per-project store that knows who owns it (the store derivation mirrors
# layout.ts runtimeRoot / harness.sh hp_runtime_dir: keyed by the project = dirname of the ABSOLUTE
# git-common-dir, '/' and '.' → '-', so a worktree and its main checkout resolve to the SAME store).
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=""
gcd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || gcd=$(realpath "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null) || gcd=""
{ [ -n "$top" ] && [ -n "$gcd" ]; } || exit 0
rd="${SPEXCODE_HOME:-$HOME/.spexcode}/projects/$(printf '%s' "$(dirname "$gcd")" | sed 's#[/.]#-#g')"

# @@@ owner-scan - the record whose worktree IS this tree. One session per worktree by construction, so the
# first match is the answer. Compared with `-ef` (same inode), not string equality: the record stores the path
# the backend created while git reports the resolved one, and a symlinked project root or macOS `/tmp` →
# `/private/tmp` would make two spellings of one tree look like two trees. A record whose worktree is gone
# (closed, moved) simply never matches. Pure bash — no fork per record, and no `grep` whose no-match exit
# would abort the hook (and the commit) under `set -euo pipefail`; an unowned tree is the ORDINARY case
# (every repo on the box that isn't a live session's worktree), never an error.
sid=""
for rec in "$rd"/sessions/*/session.json; do
  [ -e "$rec" ] || break                      # the glob didn't expand: no session ever launched in this project
  wt=""
  while IFS= read -r line; do
    case "$line" in
      *'"worktree_path"'*) wt=${line#*'"worktree_path"'}; wt=${wt#*\"}; wt=${wt%%\"*}; break ;;
    esac
  done < "$rec"
  if [ -n "$wt" ] && [ "$wt" -ef "$top" ]; then
    sid=${rec%/session.json}; sid=${sid##*/}
    break
  fi
done
[ -n "$sid" ] || exit 0

# Stamp via interpret-trailers (git's own sample-hook mechanism), NOT a raw printf append: appending after a
# message that already carries a trailer block (e.g. `spex spec ack`'s Spec-OK) opens a new paragraph, and git then
# parses ONLY the last paragraph as trailers — the earlier trailers silently become body prose. interpret-trailers
# appends into the existing block, keeping ONE parseable block. It needs the file newline-terminated first:
# on an unterminated message (git merge -m writes MERGE_MSG without one) it folds the trailer into the subject
# paragraph, where git's trailer parser never looks — the reason merge commits' Session: never parsed.
[ -n "$(tail -c1 "$msg_file")" ] && echo >> "$msg_file"
git interpret-trailers --in-place --trailer "Session: $sid" "$msg_file"
exit 0
