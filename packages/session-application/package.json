{
  "name": "@spexcode/session-application",
  "version": "0.7.0-next.7",
  "publishConfig": { "access": "public" },
  "type": "module",
  "description": "Adopter-owned composition of session protocol and topology transactions.",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node ../../scripts/build-dist.mjs",
    "prepublishOnly": "node ../../scripts/release-publish.mjs --from-package-publish",
    "test": "npm run build && tsx --import ../../scripts/test-home.mjs --test src/*.test.ts"
  },
  "dependencies": {
    "@spexcode/session-events": "0.7.0-next.7",
    "@spexcode/session-protocol": "0.7.0-next.7",
    "@spexcode/session-runtime": "0.7.0-next.7",
    "@spexcode/session-topology": "0.7.0-next.7"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
