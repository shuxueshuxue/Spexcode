{
  "name": "@spexcode/spec-dashboard",
  "version": "0.7.0-next.21",
  "type": "module",
  "exports": {
    ".": "./dist/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-public",
    "dist-public-single",
    "daemon.mjs",
    "daemon-pty.mjs"
  ],
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.0.4",
    "hono": "^4.6.14",
    "node-pty": "1.2.0-beta.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "predev": "node scripts/patch-xterm-sync-resize.mjs",
    "dev": "vite",
    "pretest": "node scripts/patch-xterm-sync-resize.mjs",
    "test": "node --test src/*.test.mjs src/i18n/*.test.mjs",
    "test:identity-e2e": "node test/identity-chain.e2e.mjs",
    "prebuild": "node scripts/patch-xterm-sync-resize.mjs",
    "build": "vite build --base ./",
    "build:public": "VITE_PUBLIC_GRAPH_ONLY=1 vite build --outDir dist-public --base ./",
    "build:public-single": "VITE_PUBLIC_GRAPH_ONLY=1 vite build --config vite.config.single.mjs --outDir dist-public-single --base ./",
    "prepack": "npm run build && npm run build:public && npm run build:public-single",
    "prepublishOnly": "node ../scripts/release-publish.mjs --from-package-publish",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.1",
    "@spexcode/archify": "0.7.0-next.21",
    "@spexcode/spec-cli": "0.7.0-next.21",
    "@spexcode/spec-core": "0.7.0-next.21",
    "@spexcode/transcript": "0.7.0-next.21",
    "@spexcode/transcript-ui": "0.7.0-next.21",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xyflow/react": "^12.3.5",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
